Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Log}"
{
	%Group Log
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Log/^*"
		}
		%File "Source/*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Log true
	{
		&
		{
			MalterlibLibrary_Log ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Log;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Log true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Log true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Log true
	}
	
	MalterlibLog_EnableVerboseDebugLog false // User: Enable verbose debug logs
	{
		!!MalterlibLog_EnableVerboseDebugLog ""
	}
	
	MalterlibLog_Severities "None"
	{
		&
		{
			MalterlibLog_Severities ""
			|
			{
				Config Release
				Config Optimized
			}
		}
	}
	
	MalterlibLog_Severities "Error;Critical;Warning;Info;Debug"
	{
		&
		{
			MalterlibLog_Severities ""
			Config "Release Testing"
		}
	}
	
	MalterlibLog_Severities "Error;Critical;Perf_Info;Perf_Warning;Perf_Error"
	{
		&
		{
			MalterlibLog_Severities ""
			Config "Profile"
		}
	}

	MalterlibLog_Severities "AllNoPerfNoVerbose"
	{
		&
		{
			MalterlibLog_Severities ""
			DebugCode true
		}
	}

	MalterlibLog_Severities "Warning;Error;Critical"
	{
		&
		{
			MalterlibLog_Severities ""
		}
	}
	
	MalterlibLog_Severities_Expand_Template "|DMibLogSeverity_@(Explodee)"
	{
		!Explodee ""
	}
	
	MalterlibLog_Severities_Expand "DMibSysLogSeverities=(DMibLogSeverity_None@(Builtin.Function->ExplodeList('@(MalterlibLog_Severities)', ';', 'MalterlibLog_Severities_Expand_Template')))"
	
	MalterlibLog_Severities "AllNoPerf"
	{
		!!MalterlibLog_EnableVerboseDebugLog true
	}

	MalterlibLog_Severities "@(MalterlibLog_EnableVerboseDebugLog)"
	{
		&
		{
			!MalterlibLog_EnableVerboseDebugLog false
			!MalterlibLog_EnableVerboseDebugLog true
			!MalterlibLog_EnableVerboseDebugLog ""
		}
	}
}

Compile
{
	!!CompileDialect "C"
	
	PreprocessorDefines "@(MalterlibLog_Severities_Expand);@(Compile.PreprocessorDefines)"
	{
		&
		{
			!MalterlibLog_Severities ""
			!Documentation Doxygen
		}
	}
	
	PreprocessorDefines "DMibSysLogSeverities=0xffff;@(Compile.PreprocessorDefines)"
	{
		!!Documentation Doxygen
	}
}
	
Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Log;@(MalterlibTests)"
	//MalterlibTestFiles_Malterlib_Log "@('Test/*'->MakeAbsolute())"
}

