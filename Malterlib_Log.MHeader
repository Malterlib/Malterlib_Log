Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Log}"
{
	%Group "Log"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Log/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Log define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Log"
	{
		!!MalterlibLibrary_Log true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Log define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Log true
	}
	
	MalterlibLog_EnableVerboseDebugLog define one_of(bool, [string]) = false // User(Log)=true: Enable verbose debug logs. You can also specify specific severeties

	MalterlibLog_Severities define [string]

	MalterlibLog_Severities []
	{
		&
		{
			MalterlibLog_Severities undefined
			|
			{
				Configuration "Release"
				Configuration "Optimized"
			}
		}
	}
	
	MalterlibLog_Severities ["Error", "Critical", "Warning", "Info", "Debug"]
	{
		&
		{
			MalterlibLog_Severities undefined
			Configuration "Release Testing"
		}
	}
	
	MalterlibLog_Severities ["Error", "Critical", "Perf_Info", "Perf_Warning", "Perf_Error"]
	{
		&
		{
			MalterlibLog_Severities undefined
			Configuration "Profile"
		}
	}

	MalterlibLog_Severities ["AllNoPerfNoVerbose"]
	{
		&
		{
			MalterlibLog_Severities undefined
			DebugCode true
		}
	}

	MalterlibLog_Severities ["Warning", "Error", "Critical"]
	{
		!!MalterlibLog_Severities undefined
	}

	MalterlibLog_Severities ["AllNoPerf"]
	{
		!!MalterlibLog_EnableVerboseDebugLog true
	}

	MalterlibLog_Severities MalterlibLog_EnableVerboseDebugLog
	{
		&
		{
			!MalterlibLog_EnableVerboseDebugLog false
			!MalterlibLog_EnableVerboseDebugLog true
			!MalterlibLog_EnableVerboseDebugLog undefined
		}
	}

	MalterlibLog_Severities_Expand_Template function(string _Severity) string = ""
	MalterlibLog_Severities_Expand_Template =+ `|DMibLogSeverity_@(_Severity)`
}

Compile
{
	!!CompileDialect "C"
	
	PreprocessorDefines += `DMibSysLogSeverities=(DMibLogSeverity_None@(MalterlibLog_Severities->ForEach("MalterlibLog_Severities_Expand_Template")))`
	{
		&
		{
			!MalterlibLog_Severities undefined
			!Documentation "Doxygen"
		}
	}
	
	PreprocessorDefines += "DMibSysLogSeverities=0xffff"
	{
		!!Documentation "Doxygen"
	}
}
	
Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Log"
	//MalterlibTestFiles_Malterlib_Log define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

